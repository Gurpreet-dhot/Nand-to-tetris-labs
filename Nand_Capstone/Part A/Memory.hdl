// by Nisan and Schocken, MIT Press.
// Capstone Project: Make the Computer Draw a Box
// Chip: Memory.hdl

/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 *
 * Address Space:
 *     0x0000 - 0x3FFF : Data RAM16K (addresses 0 to 16383)
 *     0x4000 - 0x5FFF : Screen memory map (addresses 16384 to 24575)
 *     0x6000          : Keyboard memory map (address 24576)
 */

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Address decoding:
    // address[14] == 0: RAM16K (0 to 16383)
    // address[14] == 1, address[13] == 0: Screen (16384 to 24575)
    // address[14] == 1, address[13] == 1: Keyboard (24576)

    // Route load signal based on address[14] and address[13]
    DMux(in=load, sel=address[14], a=loadRAM, b=loadIO);
    DMux(in=loadIO, sel=address[13], a=loadScreen, b=loadKBD);

    // RAM16K occupies lower 16K (addresses 0 to 16383, address[0..13])
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=outRAM);

    // Screen occupies 8K (addresses 16384 to 24575, address[0..12])
    Screen(in=in, load=loadScreen, address=address[0..12], out=outScreen);

    // Keyboard (read-only register at 24576)
    Keyboard(out=outKBD);

    // Multiplex memory outputs:
    // sel = address[13..14]
    // 00 -> RAM, 01 -> RAM, 10 -> Screen, 11 -> Keyboard
    Mux4Way16(a=outRAM, b=outRAM, c=outScreen, d=outKBD, sel=address[13..14], out=out);
}
