// This file is part of www.nand2tetris.org
// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// Capstone Project: Make the Computer Draw a Box
// Chip: CPU.hdl

/**
 * The Hack CPU (Central Processing unit), consisting of an ALU,
 * two registers named A and D, and a program counter named PC.
 * The CPU is designed to fetch and execute instructions written in 
 * the Hack machine language. In the case of a C-instruction, focuses on
 * whether to write the ALU output to the A register, D register, or memory.
 * In the case of an A-instruction, loads the 15-bit constant into the A register.
 */

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Instruction decoding:
    // instruction[15]: 0 = A-instruction, 1 = C-instruction
    Not(in=instruction[15], out=isA);
    Not(in=isA, out=isC);

    // Mux before A-Register: selects between instruction (for A-inst) and ALU output (for C-inst)
    Mux16(a=instruction, b=outALU, sel=instruction[15], out=inA);

    // Load A if A-instruction OR (C-instruction and instruction[5] == 1)
    And(a=isC, b=instruction[5], out=loadAFromC);
    Or(a=isA, b=loadAFromC, out=loadA);
    ARegister(in=inA, load=loadA, out=outA, out[0..14]=addressM);

    // Select between A-register and inM (Memory) based on instruction[12] (the 'a' bit in C-instruction)
    Mux16(a=outA, b=inM, sel=instruction[12], out=inMuxAM);

    // Load D if C-instruction and instruction[4] == 1
    And(a=isC, b=instruction[4], out=loadD);
    DRegister(in=outALU, load=loadD, out=outD);

    // ALU execution
    ALU(x=outD, y=inMuxAM,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=outALU,
        out=outM,
        zr=zr,
        ng=ng);

    // Write to M if C-instruction and instruction[3] == 1
    And(a=isC, b=instruction[3], out=writeM);

    // Jump logic evaluation:
    // ng: out < 0
    // zr: out == 0
    // pos: out > 0 (neither ng nor zr)
    Or(a=zr, b=ng, out=zrOrNg);
    Not(in=zrOrNg, out=pos);

    // Jump conditions:
    // instruction[2] = j1 (out < 0)
    // instruction[1] = j2 (out == 0)
    // instruction[0] = j3 (out > 0)
    And(a=instruction[2], b=ng, out=jlt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[0], b=pos, out=jgt);

    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jumpCond);

    // Only jump if it is a C-instruction
    And(a=isC, b=jumpCond, out=doJump);

    // Program Counter (PC):
    // load = doJump, inc = true, reset = reset
    PC(in=outA, load=doJump, inc=true, reset=reset, out[0..14]=pc);
}
